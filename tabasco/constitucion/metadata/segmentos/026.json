      "fraccion": "",
      "ruta": "Artículo 26 › párrafo 5",
      "texto": "(REFORMADO P.O. 05 DE AGOSTO DE 1998)"
    },
    {
      "id": "026.p6",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 26 › párrafo 6",
      "texto": "Para tales efectos, el Congreso tiene facultades para practicar las investigaciones que considere procedentes, por conducto del Órgano Superior de Fiscalización."
    },
    {
      "id": "026.p7",
      "tipo": "parrafo",
