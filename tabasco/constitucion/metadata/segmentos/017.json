      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 17 › párrafo 8",
      "texto": "(REFORMADO, P.O. 02 DE ABRIL DE 1975)"
    },
    {
      "id": "017.p9",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 17 › párrafo 9",
      "texto": "La misma regla se aplicará para los Diputados y Diputadas suplentes cuando sean llamados a ejercer el cargo."
    }
