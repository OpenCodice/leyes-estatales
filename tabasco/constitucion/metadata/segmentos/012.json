      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 12 › párrafo 4",
      "texto": "El Poder Legislativo se deposita en un Congreso integrado por la Cámara de Diputados. El Pleno es el órgano supremo de decisión del Congreso."
    },
    {
      "id": "012.p5",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 12 › párrafo 5",
      "texto": "REFORMADO P.O. 8469 SPTO. F 4-NOV-2023"
    },
    {
      "id": "012.p6",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 12 › párrafo 6",
      "texto": "Párrafo declarado inválido por sentencia de la SCJN a Acción de Inconstitucionalidad notificada 21-01- 2023"
    },
    {
      "id": "012.p7",
      "tipo": "parrafo",
