      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 28º › párrafo 3",
      "texto": "(REFORMADO DECRETO NO. 355, P.O. 71, SUP. 3, 04 NOVIEMBRE 2023)"
    },
    {
      "id": "028.p4",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 28º › párrafo 4",
      "texto": "La presidenta o el presidente del Congreso velará por la inviolabilidad del recinto donde celebren sus sesiones."
    }
  ]
