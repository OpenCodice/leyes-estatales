{
  "clave": "099",
  "etiqueta": "Artículo 99",
  "titulo": "TÍTULO SEXTO",
  "capitulo": "CAPÍTULO II",
  "reformas_articulo": [],
  "bloques": [
    {
      "id": "099.p1",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › párrafo 1",
      "texto": "Para ser Fiscal General del Estado se requiere:"
    },
    {
      "id": "099.I",
      "tipo": "fraccion",
      "marca": "I",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › Fracción I",
      "texto": "I.- Ser ciudadano mexicano, en pleno goce de sus derechos políticos y civiles;"
    },
    {
      "id": "099.II",
      "tipo": "fraccion",
      "marca": "II",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › Fracción II",
      "texto": "II.- Tener cuando menos treinta y cinco años cumplidos el día de su designación;"
    },
    {
      "id": "099.III",
      "tipo": "fraccion",
      "marca": "III",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › Fracción III",
      "texto": "III.- Ser profesional del derecho con título legalmente expedido, con antigüedad mínima de diez años;"
    },
    {
      "id": "099.IV",
      "tipo": "fraccion",
      "marca": "IV",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › Fracción IV",
      "texto": "IV.- Gozar de buena reputación; y"
    },
    {
      "id": "099.V",
      "tipo": "fraccion",
      "marca": "V",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 99 › Fracción V",
      "texto": "V.- No haber sido condenado por delito doloso.\n\nLa Ley fijará los requisitos que deben reunir los demás funcionarios de la Fiscalía General del Estado."
    }
  ]
}
