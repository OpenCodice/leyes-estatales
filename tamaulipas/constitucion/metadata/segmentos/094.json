{
  "clave": "094",
  "etiqueta": "Artículo 94",
  "titulo": "",
  "capitulo": "CAPÍTULO II",
  "reformas_articulo": [],
  "bloques": [
    {
      "id": "094.p1",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › párrafo 1",
      "texto": "Para el desempeño de los asuntos oficiales, el Ejecutivo tendrá un funcionario que se denominará \"Secretario General de Gobierno\"."
    },
    {
      "id": "094.p2",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › párrafo 2",
      "texto": "Para ser Secretario General de Gobierno, se requiere:"
    },
    {
      "id": "094.I",
      "tipo": "fraccion",
      "marca": "I",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › Fracción I",
      "texto": "I.- Ser ciudadano mexicano en ejercicio de sus derechos;"
    },
    {
      "id": "094.II",
      "tipo": "fraccion",
      "marca": "II",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › Fracción II",
      "texto": "II.- Ser mayor de treinta años de edad;"
    },
    {
      "id": "094.III",
      "tipo": "fraccion",
      "marca": "III",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › Fracción III",
      "texto": "III.- Poseer instrucción escolar suficiente;"
    },
    {
      "id": "094.IV",
      "tipo": "fraccion",
      "marca": "IV",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › Fracción IV",
      "texto": "IV.- No ser militar ni ministro de algún culto, esté o no en ejercicio;"
    },
    {
      "id": "094.V",
      "tipo": "fraccion",
      "marca": "V",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 94 › Fracción V",
      "texto": "V.- No haber sido condenado por delito infamante. La calificación la hace el H. Congreso."
    }
  ]
}
