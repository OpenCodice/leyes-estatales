  "titulo": "TITULO QUINTO",
  "capitulo": "",
  "reformas_articulo": [],
  "bloques": [
    {
      "id": "083.p1",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 1",
      "texto": "(REFORMADO, P.O. 15 DE AGOSTO DE 2025)"
    },
    {
      "id": "083.p2",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 2",
      "texto": "El Supremo Tribunal de Justicia se compondrá del número de personas Magistradas propietarias o supernumerarias que determine el Órgano de Administración del Poder Judicial."
    },
    {
      "id": "083.p3",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 3",
      "texto": "(REFORMADO, P.O. 15 DE AGOSTO DE 2025)"
    },
    {
      "id": "083.p4",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 4",
      "texto": "La presidencia se renovará cada tres años, en los términos previstos en la Ley Orgánica del Poder Judicial del Estado. La Presidencia no podrá ser reelecta para el período inmediato posterior."
    },
    {
      "id": "083.p5",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 5",
      "texto": "(ADICIONADO, P.O. 7 DE NOVIEMBRE DE 2006)"
    },
    {
      "id": "083.p6",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 6",
      "texto": "No podrá ser electo para ejercer el cargo de Presidente del Supremo Tribunal de Justicia el Magistrado cuyo nombramiento concluya en el periodo en el que habrá de designarse dicho cargo."
    },
    {
      "id": "083.p7",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 7",
      "texto": "(REFORMADO, P.O. 15 DE AGOSTO DE 2025)"
    },
    {
      "id": "083.p8",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 83 › párrafo 8",
      "texto": "El informe anual de labores del Poder Judicial del Estado se rendirá en el mes de diciembre por quien ejerza la presidencia del Supremo Tribunal de Justicia."
    }
  ]
}
