      "ruta": "Artículo 43 › párrafo 1",
      "texto": "(REFORMADO, P.O. 4 DE FEBRERO DE 1982)"
    },
    {
      "id": "043.p2",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 43 › párrafo 2",
      "texto": "Los Diputados deberán cumplir puntualmente sus deberes legislativos, de gestoría y representación, así como los de fiscalización y control del ingreso y gasto públicos, conforme lo determine la Ley Orgánica."
    },
    {
      "id": "043.p3",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 43 › párrafo 3",
      "texto": "Las oficinas públicas deberán facilitar el cumplimiento de estas obligaciones."
    }
  ]
