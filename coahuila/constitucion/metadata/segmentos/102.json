      "ruta": "Artículo 102º › párrafo 3",
      "texto": "(ADICIONADO, P.O. 19 DE SEPTIEMBRE DE 2003)"
    },
    {
      "id": "102.p4",
      "tipo": "parrafo",
      "marca": "",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 102º › párrafo 4",
      "texto": "La disponibilidad presupuestal en materia de acceso a la información pública, se regirá por la eficiencia, racionalidad, optimización de recursos e interés social."
