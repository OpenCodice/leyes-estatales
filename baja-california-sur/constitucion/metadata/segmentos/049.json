      "tipo": "fraccion",
      "marca": "I",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 49. › Fracción I",
      "texto": "I.- Asistir regularmente a las sesiones."
    },
    {
      "id": "049.II",
      "tipo": "fraccion",
      "marca": "II",
      "apartado": "",
      "fraccion": "",
      "ruta": "Artículo 49. › Fracción II",
